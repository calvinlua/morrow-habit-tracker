# Copy to backend/.env before running the API: cp backend/.env.example backend/.env
#
# This file lives next to the Prisma schema because the Prisma CLI resolves
# .env from the directory it runs in, and npm runs workspace scripts from the
# package directory. The API itself will also read a .env at the repo root.

# Matches the dev database in docker-compose.yml.
DATABASE_URL="mysql://habit:habit@127.0.0.1:3307/habit_tracker"

# `prisma migrate dev` needs a scratch database to detect schema drift. The dev
# container creates this one and grants the app user rights on it, so the app
# account still has no privileges outside its own two databases.
SHADOW_DATABASE_URL="mysql://habit:habit@127.0.0.1:3307/habit_tracker_shadow"

PORT=3001

# Timezone used to decide which calendar day "today" is. See README for why
# this is a single app-wide setting rather than a per-user one.
APP_TIMEZONE=Asia/Singapore
